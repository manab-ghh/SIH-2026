# ============================================================
# ShilpSetu AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file
# ============================================================

PORT=8000
NODE_ENV=development

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/shilpsetu
# Atlas:      mongodb+srv://<user>:<password>@cluster.mongodb.net/shilpsetu
MONGO_URI=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — allowed frontend origin (* for development)
CLIENT_URL=*

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# AI Provider: 'mock' uses built-in simulation, replace with real provider
# Options: mock | openai | gemini | custom
AI_PROVIDER=mock
